# Set this in the server environment before starting Flask (not auto-loaded).
# Use a stable address reachable by phones on the factory network.
PUBLIC_BASE_URL=http://fnms.company.local

# Optional persistent Catalog image folder. Default: uploads/switch-catalog beside SQLite.
# Set an absolute path in the server environment (not auto-loaded).
# CATALOG_IMAGE_DIR=D:/FNMS/data/uploads/switch-catalog
